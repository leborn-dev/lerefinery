source "https://rubygems.org"

gemspec

# Safe defaults for newly generated development/test applications.
gem 'rails', '>= 7.2.4', '< 9',
             '!= 8.0.0', '!= 8.0.0.1', '!= 8.0.1', '!= 8.0.2', '!= 8.0.2.1', '!= 8.0.3', '!= 8.0.4', '!= 8.0.4.1', '!= 8.0.5',
             '!= 8.1.0', '!= 8.1.1', '!= 8.1.2', '!= 8.1.2.1', '!= 8.1.3'

# Verified security remediation snapshot; see readme.md before updating.
git 'https://github.com/leborn-dev/lerefinery.git', :ref => 'dcceb2f22ad01816d089064ae5872a795a7bbb6e' do
  gem 'refinerycms'

  group :development, :test do
    gem 'refinerycms-testing', '~> <%= Refinery::Version %>'
  end
end

# The published decorators gem caps railties below the patched Rails line.
# Use the same verified Zeitwerk-compatible source as Refinery's own Gemfile.
gem 'decorators', git: 'https://github.com/parndt/decorators.git',
                  ref: '8ba6dc68c30b5400ee97c642d57748ecaa94830c'

# Database Configuration
platforms :jruby do
  gem 'activerecord-jdbcsqlite3-adapter'
  gem 'activerecord-jdbcmysql-adapter'
  gem 'activerecord-jdbcpostgresql-adapter'
  gem 'jruby-openssl'
end

platforms :ruby do
  gem 'sqlite3', '>= 2.9.6'
  gem 'mysql2', '~> 0.5', '>= 0.5.7'
  gem 'pg'
end

group :development, :test do
  gem 'rspec-its' # for the model's validation tests.
  # Hash.from_xml in the test helpers requires an explicit, patched REXML.
  gem 'rexml', '>= 3.4.4'
end

# Gems used only for assets and not required
# in production environments by default.
group :assets do
  gem 'sass-rails'
  # ExecJS uses the supported Node.js LTS runtime documented in readme.md.
  gem 'uglifier'
end
